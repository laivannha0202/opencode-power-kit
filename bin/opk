#!/usr/bin/env bash
# OpenCode Power Kit CLI — Linux-only, version is read from ./VERSION.
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
if [[ -n "${OPK_KIT_DIR:-}" && -f "$OPK_KIT_DIR/install.sh" ]]; then KIT_DIR="$OPK_KIT_DIR"; else KIT_DIR="$(cd "$BIN_DIR/.." && pwd)"; fi
[[ -f "$KIT_DIR/install.sh" ]] || { echo "opk: kit not found: $KIT_DIR" >&2; exit 1; }
# shellcheck source=scripts/require-linux.sh
source "$KIT_DIR/scripts/require-linux.sh"; opk_require_linux
VERSION="$(cat "$KIT_DIR/VERSION" 2>/dev/null || echo '?')"
err(){ echo "opk: $*" >&2; exit 1; }
need(){ [[ -f "$1" ]] || err "missing file: $1"; }
# shellcheck source=scripts/opk-commands.sh
source "$KIT_DIR/scripts/opk-commands.sh"
run_script(){ need "$1"; exec bash "$1" "${@:2}"; }
_guard(){ command -v "$1" >/dev/null 2>&1 || err "missing command layer: $1"; }
cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) cat <<HELP
opk v$VERSION — OpenCode Power Kit

Core:
  opk global | install | fullstack | verify | doctor | one | all
  opk update [--dry-run] [--yes] [--clean] [--profile auto|none|node-nest-react-mysql]
  opk update-all [--dry-run] [--yes] [--with-gsd] [--with-optional] [--refresh-superpowers]
  opk mode [show|power|safe|migrate] [--normalize-jsonc]
  opk permissions doctor
  opk auto [opencode args...]
  opk run-auto "prompt"
  opk safety-plugin status|install [--yes]
  opk guard status|install [--yes]|uninstall

Integrations:
  opk bmad status|update [--stable|--next|--version X.Y.Z]
  opk gsd [status|install]     opk taste install|status|doctor|off|update
  opk markitdown install|status|update
  opk supermemory install|status|update|init|init-help
  opk ecc audit|lite|status|update|off
  opk hermes audit [--dry-run|--check|--write|--help] | status | capsule | off | help
  opk upstream audit|doctor   opk superpowers status|reset-cache|doctor

Safety: updater dry-runs are read-only, pulls fail-fast, and missing optional
integrations are not installed unless --with-optional is explicit.
HELP
    ;;
  version|-v|--version) echo "opk $VERSION" ;;
  path) echo "$KIT_DIR" ;;
  mode) sub="${1:-show}"; shift || true
    case "$sub" in show) _guard opk_mode_show; opk_mode_show "$@";; power) _guard opk_mode_power; opk_mode_power "$@";; safe) _guard opk_mode_safe; opk_mode_safe "$@";; migrate) _guard opk_mode_migrate; opk_mode_migrate "$@";; *) err 'mode: use show|power|safe|migrate';; esac ;;
  permissions) sub="${1:-doctor}"; shift || true
    [[ "$sub" == doctor && $# -eq 0 ]] || err 'permissions: use doctor'
    _guard opk_permissions_doctor; opk_permissions_doctor ;;
  auto) _guard opk_auto; opk_auto "$@" ;;
  run-auto) _guard opk_run_auto; opk_run_auto "$@" ;;
  safety-plugin) sub="${1:-status}"; shift || true
    case "$sub" in status) _guard opk_safety_plugin_status; opk_safety_plugin_status;; install) safe_opencode_project || err 'run inside a safe project with a project marker'; run_script "$KIT_DIR/scripts/install-safety-plugin.sh" "$@";; *) err 'safety-plugin: use status|install';; esac ;;
  guard) sub="${1:-status}"; shift || true
    case "$sub" in status) _guard opk_guard_status; opk_guard_status;; install) run_script "$KIT_DIR/scripts/install-guard.sh" "$@";; uninstall) run_script "$KIT_DIR/scripts/install-guard.sh" --uninstall;; *) err 'guard: use status|install|uninstall';; esac ;;
  global) run_script "$KIT_DIR/install-global.sh" "$@" ;;
  quick) run_script "$KIT_DIR/install-global.sh" --yes "$@" ;;
  install|project|init) safe_project || err 'run inside a real project'; run_script "$KIT_DIR/install.sh" "$@" ;;
  fullstack) safe_project || err 'run inside a real project'; run_script "$KIT_DIR/scripts/install-fullstack-profile.sh" "$@" ;;
  verify) run_script "$KIT_DIR/verify.sh" "$@" ;;
  doctor) run_script "$KIT_DIR/doctor.sh" "$@" ;;
  bootstrap) run_script "$KIT_DIR/bootstrap.sh" "$@" ;;
  one|go) run_script "$KIT_DIR/bootstrap.sh" --all --project-dir "$PWD" --yes "$@" ;;
  all) _guard opk_all; opk_all ;;
  up|update|upgrade) run_script "$KIT_DIR/scripts/update-opk.sh" project "$@" ;;
  update-all) run_script "$KIT_DIR/scripts/update-opk.sh" all "$@" ;;
  clean) run_script "$KIT_DIR/scripts/cleanup-agent-artifacts.sh" "$@" ;;
  update-bmad) safe_project || err 'run inside a real project'; run_script "$KIT_DIR/update-bmad.sh" "$@" ;;
  bmad) sub="${1:-status}"; shift || true
    case "$sub" in status) _guard opk_bmad_status; opk_bmad_status;; update) _guard opk_bmad_update; opk_bmad_update "$@";; *) err 'bmad: use status|update';; esac ;;
  gsd|update-gsd) sub="${1:-install}"
    if [[ "$sub" == status ]]; then shift; run_script "$KIT_DIR/scripts/install-gsd-core.sh" status "$@"; fi
    [[ "$sub" == install ]] && shift || true
    run_script "$KIT_DIR/scripts/install-gsd-core.sh" "$@" ;;
  taste|taste-status|taste-off|update-taste) case "$cmd" in taste-status) set -- status "$@";; taste-off) set -- off "$@";; update-taste) set -- update "$@";; esac
    sub="${1:-status}"; shift || true
    case "$sub" in install) run_script "$KIT_DIR/scripts/install-taste-skill.sh" "$@";; update) run_script "$KIT_DIR/scripts/install-taste-skill.sh" --refresh "$@";; status) _guard opk_taste_status; opk_taste_status;; doctor) _guard opk_taste_doctor; opk_taste_doctor;; off) _guard opk_taste_off; opk_taste_off;; *) err 'taste: use install|update|status|doctor|off';; esac ;;
  markitdown) sub="${1:-status}"; shift || true
    case "$sub" in install) run_script "$KIT_DIR/scripts/install-markitdown.sh" "$@";; update) run_script "$KIT_DIR/scripts/install-markitdown.sh" --upgrade "$@";; status) command -v markitdown || true;; *) err 'markitdown: install|update|status';; esac ;;
  supermemory) sub="${1:-status}"; shift || true
    case "$sub" in
      install) run_script "$KIT_DIR/scripts/install-supermemory.sh" "$@" ;;
      update) run_script "$KIT_DIR/scripts/install-supermemory.sh" --upgrade "$@" ;;
      status) command -v supermemory || true ;;
      init-help) if command -v supermemory >/dev/null; then exec supermemory init --help; fi; echo 'Usage: supermemory init [options]. Run: opk supermemory install' ;;
      init) if command -v supermemory >/dev/null; then exec supermemory init "$@"; fi; [[ "${1:-}" == --help || "${1:-}" == -h ]] && { echo 'Usage: supermemory init [options]. Run: opk supermemory install'; exit 0; }; err 'not installed' ;;
      *) err 'supermemory: install|update|status|init|init-help' ;;
    esac ;;
  ecc|ec|e|update-ecc) [[ "$cmd" == update-ecc ]] && set -- update "$@"
    sub="${1:-status}"; shift || true
    case "$sub" in audit) run_script "$KIT_DIR/scripts/audit-ecc.sh" "$@";; lite) run_script "$KIT_DIR/scripts/install-ecc-lite.sh" "$@";; update) run_script "$KIT_DIR/scripts/install-ecc-lite.sh" --refresh "$@";; status) run_script "$KIT_DIR/scripts/check-ecc-lite.sh" "$@";; off) _guard opk_ecc_off; opk_ecc_off;; *) err 'ecc: audit|lite|update|status|off';; esac ;;
  hermes|hermes-status) [[ "$cmd" == hermes-status ]] && set -- status "$@"
    sub="${1:-status}"; shift || true
    case "$sub" in audit) (($# > 0)) || set -- --check; run_script "$KIT_DIR/scripts/audit-hermes.sh" "$@";; status) run_script "$KIT_DIR/scripts/check-hermes-lite.sh" "$@";; capsule) run_script "$KIT_DIR/scripts/hermes-learning-capsule.sh" "$@";; off) _guard opk_hermes_off; opk_hermes_off;; help|-h|--help) echo 'Usage: opk hermes audit [--dry-run|--check|--write|--help] | status | capsule | off | help';; *) err 'hermes: audit|status|capsule|off|help';; esac ;;
  upstream) sub="${1:-audit}"; shift || true
    case "$sub" in audit) exec python3 "$KIT_DIR/scripts/audit-upstreams.py" "$@";; doctor) python3 "$KIT_DIR/scripts/audit-upstreams.py" --check; python3 "$KIT_DIR/scripts/validate-opencode-pack.py";; *) err 'upstream: audit|doctor';; esac ;;
  superpowers) sub="${1:-status}"; shift || true
    case "$sub" in status|doctor) _guard opk_superpowers_status; opk_superpowers_status;; reset-cache) run_script "$KIT_DIR/scripts/update-opk.sh" all --refresh-superpowers "$@";; *) err 'superpowers: status|doctor|reset-cache';; esac ;;
  tools|tooling) run_script "$KIT_DIR/scripts/install-token-tools.sh" "$@" ;;
  md-convert|doc-to-md) command -v markitdown >/dev/null || err 'install MarkItDown first'; [[ $# -ge 2 ]] || err "usage: opk $cmd input output"; markitdown "$1" >"$2" ;;
  trash) _guard opk_trash_known; opk_trash_known ;;
  recover-legacy) _guard opk_recover_legacy; opk_recover_legacy "$@" ;;
  *) err "unknown command '$cmd'; run: opk help" ;;
esac
