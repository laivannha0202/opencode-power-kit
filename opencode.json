{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.2.0"
  ],
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*secret*": "deny",
      "*private-key*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "task": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "sudo rm -rf*": "deny",
      "sudo rm -fr*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "*DROP TABLE*": "deny",
      "*DROP DATABASE*": "deny",
      "*TRUNCATE*": "deny",
      "*DELETE FROM*": "deny",
      "curl *| *sh*": "deny",
      "curl *| *bash*": "deny",
      "wget *| *sh*": "deny",
      "wget *| *bash*": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".nuxt/**",
      ".turbo/**",
      ".cache/**",
      "vendor/**",
      "target/**",
      ".opk-trash/**",
      ".opk-checkpoints/**"
    ]
  }
}
