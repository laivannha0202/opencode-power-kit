[
  {
    "id": "contract-001",
    "name": "Windows runtime artifacts removed",
    "description": "Linux-only distribution must not ship PowerShell, CMD, or BAT entrypoints",
    "check_type": "file_absent",
    "targets": [
      "bin/opk.cmd",
      "bin/opk.ps1",
      "bootstrap.ps1",
      "doctor.ps1",
      "install-global.ps1",
      "install.ps1",
      "setup.ps1",
      "update-bmad.ps1",
      "verify.ps1",
      "scripts/check-taste-skill.ps1",
      "scripts/install-fullstack-profile.ps1",
      "scripts/install-gsd-core.ps1",
      "scripts/install-markitdown.ps1",
      "scripts/install-safety-plugin.ps1",
      "scripts/install-supermemory.ps1",
      "scripts/install-taste-skill.ps1",
      "scripts/test-timeout.ps1",
      "scripts/timeout.ps1"
    ],
    "expected": "all_absent"
  },
  {
    "id": "contract-002",
    "name": "Linux-only support documented",
    "description": "README must clearly declare the supported platform",
    "check_type": "grep_present",
    "target": "README.md",
    "patterns": [
      "Linux-only",
      "Linux"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-003",
    "name": ".gitignore allows .opencode/",
    "description": ".gitignore must not block the .opencode directory",
    "check_type": "grep_absent",
    "target": ".gitignore",
    "patterns": [
      "^\\.opencode/$",
      "opk-free-models"
    ],
    "expected": "all_absent"
  },
  {
    "id": "contract-004",
    "name": "Linux platform guard exists",
    "description": "Shared platform guard must identify Linux with uname",
    "check_type": "grep_present",
    "target": "scripts/require-linux.sh",
    "patterns": [
      "uname -s",
      "Linux"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-005",
    "name": "Safety plugin uses correct pattern",
    "description": "test-safety-plugin.mjs must pass",
    "check_type": "script_exec",
    "command": "node scripts/test-safety-plugin.mjs",
    "expected_exit": 0
  },
  {
    "id": "contract-006",
    "name": "Permission ordering correct",
    "description": "test-permission-rules.py must pass",
    "check_type": "script_exec",
    "command": "python3 scripts/test-permission-rules.py",
    "expected_exit": 0
  },
  {
    "id": "contract-007",
    "name": "GitHub Actions disabled",
    "description": "Local Linux validation is authoritative",
    "check_type": "file_absent",
    "targets": [
      ".github/workflows/ci.yml",
      ".github/workflows/verify.yml"
    ],
    "expected": "all_absent"
  },
  {
    "id": "contract-011",
    "name": "Writer and read-only reviewer policy",
    "description": "build-strong must define the reviewer as read-only",
    "check_type": "grep_present",
    "target": "opencode-global/agents/build-strong.md",
    "patterns": [
      "Reviewer read-only",
      "read-only"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-012",
    "name": "build-strong pipeline stages",
    "description": "build-strong must define all seven pipeline stages",
    "check_type": "grep_present",
    "target": "opencode-global/agents/build-strong.md",
    "patterns": [
      "Intake",
      "Context",
      "Plan",
      "Implement",
      "Review",
      "Verify",
      "Report"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-013",
    "name": "Timeout helper exists and runs",
    "description": "scripts/timeout.sh must run without error",
    "check_type": "script_exec",
    "command": "bash scripts/timeout.sh 5 true",
    "expected_exit": 0
  },
  {
    "id": "contract-014",
    "name": "Fallback timeout exits 124",
    "description": "Forced fallback must return 124 when the command times out",
    "check_type": "script_exec",
    "command": "env OPK_TIMEOUT_FORCE_FALLBACK=1 bash scripts/timeout.sh 1 sleep 10",
    "expected_exit": 124
  },
  {
    "id": "contract-015",
    "name": "Fallback timeout preserves exit code",
    "description": "Forced fallback must preserve a normal child exit code",
    "check_type": "script_exec",
    "command": "env OPK_TIMEOUT_FORCE_FALLBACK=1 bash scripts/timeout.sh 5 sh -c 'exit 42'",
    "expected_exit": 42
  },
  {
    "id": "contract-016a",
    "name": "backend-route-review exists",
    "description": "Backend route review command must exist",
    "check_type": "file_present",
    "targets": [
      "opencode-global/commands/backend-route-review.md"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-018",
    "name": "README agent count accurate",
    "description": "README must show 16 active agents",
    "check_type": "grep_present",
    "target": "README.md",
    "patterns": [
      "16 active agents"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-019",
    "name": "README command count accurate",
    "description": "README must show 71 commands",
    "check_type": "grep_present",
    "target": "README.md",
    "patterns": [
      "71 commands"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-020",
    "name": "No unsupported quality scorecard",
    "description": "README must not claim arbitrary 10 out of 10 scores",
    "check_type": "grep_absent",
    "target": "README.md",
    "patterns": [
      "Quality Scorecard",
      "10/10"
    ],
    "expected": "all_absent"
  },
  {
    "id": "contract-021",
    "name": "Upstream capability map has correct URLs and pins",
    "description": "Capability map must retain validated upstream references",
    "check_type": "grep_present",
    "target": "docs/UPSTREAM_CAPABILITY_MAP.md",
    "patterns": [
      "v6.2.0 (central + template pin)",
      "6.10.0 (CLI/update pin)",
      "@1.8.0 (reviewed central pin)",
      "https://github.com/obra/superpowers.git",
      "https://github.com/bmad-code-org/BMAD-METHOD",
      "https://github.com/open-gsd/gsd-core",
      "https://github.com/rohitg00/agentmemory"
    ],
    "expected": "all_present"
  },
  {
    "id": "contract-022",
    "name": "Default timeout path returns 124",
    "description": "System timeout path must return 124",
    "check_type": "script_exec",
    "command": "bash scripts/timeout.sh 1 sleep 10",
    "expected_exit": 124
  },
  {
    "id": "contract-023",
    "name": "Timeout kills grandchild processes",
    "description": "Timeout must kill child and grandchild processes",
    "check_type": "script_exec",
    "command": "bash scripts/test-timeout.sh --grandchild",
    "expected_exit": 0
  },
  {
    "id": "contract-024",
    "name": "Default timeout path preserves exit code",
    "description": "System timeout path must preserve a normal child exit code",
    "check_type": "script_exec",
    "command": "bash scripts/timeout.sh 5 sh -c 'exit 42'",
    "expected_exit": 42
  },
  {
    "id": "contract-025",
    "name": "GSD status is stable",
    "description": "install-gsd-core.sh status must not fail under set -u",
    "check_type": "script_exec",
    "command": "bash scripts/install-gsd-core.sh status",
    "expected_exit": 0
  },
  {
    "id": "contract-026",
    "name": "Third-party references are pinned",
    "description": "THIRD_PARTY.md must retain the expected pins and repositories",
    "check_type": "grep_present",
    "target": "THIRD_PARTY.md",
    "patterns": [
      "6.10.0",
      "@1.8.0",
      "rohitg00/agentmemory",
      "obra/superpowers"
    ],
    "expected": "all_present"
  }
]
