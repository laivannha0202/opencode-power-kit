{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "opk-main",
  "subagent_depth": 1,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*secret*": "deny",
      "*private-key*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "task": "ask",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "sudo rm -rf*": "deny",
      "sudo rm -fr*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "*DROP TABLE*": "deny",
      "*DROP DATABASE*": "deny",
      "*TRUNCATE*": "deny",
      "*DELETE FROM*": "deny",
      "curl *| *sh*": "deny",
      "curl *| *bash*": "deny",
      "wget *| *sh*": "deny",
      "wget *| *bash*": "deny",
      "*.env*": "deny",
      "*secret*": "deny",
      "*private-key*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*credentials*": "deny",
      "*.netrc*": "deny",
      "*.ssh/*": "deny",
      "*.aws/credentials*": "deny",
      "*.kube/config*": "deny",
      "*opencode/auth.json*": "deny",
      "*claude/credentials.json*": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".nuxt/**",
      ".turbo/**",
      ".cache/**",
      "vendor/**",
      "target/**",
      ".opk-trash/**",
      ".opk-checkpoints/**"
    ]
  }
}
